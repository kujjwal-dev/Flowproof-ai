{
  "packageDirectories": [
    {
      "path": "force-app",
      "default": true,
      "package": "FlowProof AI",
      "versionName": "Pilot",
      "versionNumber": "0.1.0.NEXT",
      "versionDescription": "Record-triggered Flow investigations with evidence labels, Check all Flows, what-if checks, Flow health suggestions and optional AI explanations."
    },
    {
      "path": "demo",
      "default": false
    },
    {
      "path": "org-config",
      "default": false
    }
  ],
  "name": "flowproof-ai",
  "namespace": "",
  "sfdcLoginUrl": "https://login.salesforce.com",
  "sourceApiVersion": "68.0",
  "replacements": [
    {
      "glob": "org-config/**/*-meta.xml",
      "stringToReplace": "__FLOWPROOF_ORG_URL__",
      "replaceWithEnv": "FLOWPROOF_ORG_URL"
    }
  ],
  "packageAliases": {
    "FlowProof AI": "0Hobm0000008WkHCAU",
    "FlowProof AI@0.1.0-1": "04tbm000000qKM1AAM"
  }
}

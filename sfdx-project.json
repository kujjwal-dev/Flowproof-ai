{
  "packageDirectories": [
    {
      "path": "force-app",
      "default": true,
      "package": "FlowProof AI",
      "versionName": "Pilot 2",
      "versionNumber": "0.2.0.NEXT",
      "versionDescription": "Adds Record a test save: shows which Flows really ran on a save, from its debug log."
    },
    {
      "path": "demo",
      "default": false
    },
    {
      "path": "org-config",
      "default": false
    }
  ],
  "name": "flowproof-ai",
  "namespace": "",
  "sfdcLoginUrl": "https://login.salesforce.com",
  "sourceApiVersion": "68.0",
  "replacements": [
    {
      "glob": "org-config/**/*-meta.xml",
      "stringToReplace": "__FLOWPROOF_ORG_URL__",
      "replaceWithEnv": "FLOWPROOF_ORG_URL"
    }
  ],
  "packageAliases": {
    "FlowProof AI": "0Hobm0000008WkHCAU",
    "FlowProof AI@0.1.0-1": "04tbm000000qKM1AAM",
    "FlowProof AI@0.2.0-1": "04tbm000000qMndAAE"
  }
}

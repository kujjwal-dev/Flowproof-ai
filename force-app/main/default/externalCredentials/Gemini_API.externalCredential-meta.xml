<?xml version="1.0" encoding="UTF-8" ?>
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <authenticationProtocol>Custom</authenticationProtocol>
    <description
  >FlowProof AI: Gemini API key, sent as the x-goog-api-key header. An admin enters the key in Setup as the ApiKey authentication parameter of the GeminiKey principal. Never stored in source control.</description>
    <externalCredentialParameters>
        <parameterGroup>DefaultGroup</parameterGroup>
        <parameterName>x-goog-api-key</parameterName>
        <parameterType>AuthHeader</parameterType>
        <parameterValue>{!$Credential.Gemini_API.ApiKey}</parameterValue>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <externalCredentialParameters>
        <parameterGroup>GeminiKey</parameterGroup>
        <parameterName>GeminiKey</parameterName>
        <parameterType>NamedPrincipal</parameterType>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <label>Gemini API</label>
</ExternalCredential>
